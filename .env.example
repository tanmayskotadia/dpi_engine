# =============================================================================
# DPI Engine — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in values appropriate for your environment.
# .env is gitignored — never commit secrets or machine-specific paths.
# =============================================================================

# ── Backend Server ────────────────────────────────────────────────────────────

# TCP port the Express backend listens on.
# Default: 3000
PORT=3000

# Allowed CORS origin for the frontend.
# In development this can be '*' or 'http://localhost:5173'.
# In production, set this to the exact frontend URL to prevent unauthorized access.
# Default: * (allow all — only safe in development)
CORS_ORIGIN=*

# ── C++ DPI Engine ────────────────────────────────────────────────────────────

# Absolute path to the compiled packet_analyzer executable.
# If not set, the server searches in these locations (in order):
#   1. <project-root>/build/Release/packet_analyzer[.exe]
#   2. <project-root>/build/Debug/packet_analyzer[.exe]
#   3. <project-root>/build/packet_analyzer[.exe]
#   4. <project-root>/packet_analyzer[.exe]
# Leave blank to use the automatic discovery above.
# DPI_ENGINE_PATH=

# Maximum number of Load Balancer threads the user can request.
# Default: 16
ENGINE_MAX_LBS=16

# Maximum number of Fast Path threads per Load Balancer.
# Default: 16
ENGINE_MAX_FPS_PER_LB=16

# Default thread counts applied when the user doesn't specify values.
ENGINE_DEFAULT_LBS=2
ENGINE_DEFAULT_FPS=2

# ── PCAP Storage ──────────────────────────────────────────────────────────────

# Directory where uploaded PCAP files are stored.
# Default: <project-root>/uploads
# PCAP_STORAGE_PATH=

# Directory where processed (output) PCAP files are written.
# Default: <project-root>/uploads/outputs
# PCAP_OUTPUT_PATH=

# Maximum PCAP upload size in megabytes.
# Default: 500
PCAP_MAX_FILE_SIZE_MB=500

# ── Frontend (Vite dev server) ────────────────────────────────────────────────

# URL of the backend to proxy /api calls to in development.
# Default: http://localhost:3000
# VITE_BACKEND_URL=http://localhost:3000

# Port for the Vite dev server.
# Default: 5173
# VITE_PORT=5173
